{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_framework/**", "/_content/**", "/images/**", "/models/**", "/textures/**", "*.js", "*.json", "*.css", "*.ico", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.svg", "*.webp"]
  },
  "responseHeaders": {
    "Cache-Control": "public, max-age=31536000"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}