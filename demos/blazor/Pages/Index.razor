@page "/"
@using PointOfAttention.UI.Blazor
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Point of Attention Blazor Demo</PageTitle>
<div class="app-shell">
    <header class="app-header">
        <div class="app-header-lead">
            <button class="icon-btn menu-toggle" type="button"
                    aria-label="Toggle scenario menu" aria-controls="scenario-menu"
                    aria-expanded="@(ScenarioMenuOpen ? "true" : "false")"
                    @onclick="() => ScenarioMenuOpen = !ScenarioMenuOpen"><span aria-hidden="true">☰</span></button>
            <h1 class="app-title">
                <span class="app-title-text">Point of Attention — @(ModelUrl is null ? "Demo" : ActiveLabel)</span>
                <span class="app-badge">Blazor</span>
            </h1>
        </div>
        <div class="app-header-actions">
            @if (ModelUrl is not null)
            {
                <button class="toolbar-btn" type="button" @onclick="ChangeDemo">Close demo</button>
            }
            <a class="app-link" href="https://github.com/LucaAstolfi88/point-of-attention-ui" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
    </header>

    @if (ModelUrl is not null)
    {
        <div class="app-toolbar">
            <div class="page-tabs" role="tablist" aria-label="Viewer pages">
                <button role="tab" type="button" aria-selected="@(Page == "viewer" ? "true" : "false")" class="@(Page == "viewer" ? "active" : null)" @onclick='() => SetPage("viewer")'>Inspection</button>
                <button role="tab" type="button" aria-selected="@(Page == "analytics" ? "true" : "false")" class="@(Page == "analytics" ? "active" : null)" @onclick='() => SetPage("analytics")'>Analytics</button>
            </div>
            <div class="toolbar-group">
                <span class="toolbar-label">Camera:</span>
                @foreach (var view in CameraViews)
                {
                    <button class="toolbar-btn" type="button" @onclick="() => SetCameraView(view)">@view</button>
                }
                <button class="toolbar-btn toolbar-btn--accent" type="button" @onclick="ZoomToFit">Zoom Fit</button>
            </div>
            <div class="toolbar-group">
                <button class="toolbar-btn" type="button" title="Undo" @onclick="Undo">↩ Undo</button>
                <button class="toolbar-btn" type="button" title="Redo" @onclick="Redo">↪ Redo</button>
                <button class="toolbar-btn toolbar-btn--danger" type="button" @onclick="ClearAll">✕ Clear All</button>
            </div>
            <div class="toolbar-group">
                <span class="toolbar-stat">Defects: <strong>@Defects.Count</strong></span>
                <span class="toolbar-stat">Parts: <strong>@Parts.Count</strong></span>
            </div>
        </div>
    }

    <div class="app-main">
        @if (ScenarioMenuOpen)
        {
            <button type="button" class="drawer-backdrop" aria-label="Close scenario menu"
                    @onclick="() => ScenarioMenuOpen = false"></button>
        }
        <aside id="scenario-menu" class="scenario-sidebar @(ScenarioMenuOpen ? null : "scenario-sidebar--collapsed")">
            <div class="scenario-sidebar-head">
                <h2 class="sidebar-title">Demo scenarios</h2>
                <button class="menu-collapse-btn" type="button"
                        aria-expanded="@(ScenarioMenuOpen ? "true" : "false")"
                        aria-label="@(ScenarioMenuOpen ? "Collapse scenario menu" : "Expand scenario menu")"
                        @onclick="() => ScenarioMenuOpen = !ScenarioMenuOpen"><span class="chev" aria-hidden="true">›</span></button>
            </div>
            <nav class="scenario-menu" aria-label="Demo scenarios">
                @foreach (var asset in Models)
                {
                    <details class="scenario-model" open>
                        <summary>@asset.Label</summary>
                        @foreach (var item in asset.Scenarios ?? [])
                        {
                            <button type="button"
                                    class="scenario-button @(ActiveLabel == $"{asset.Label} — {item.Label}" ? "scenario-button--active" : null)"
                                    @onclick="() => PickScenario(asset, item)">
                                <span>@item.Label</span>
                                @if (!string.IsNullOrEmpty(item.Badge)) { <small>@item.Badge</small> }
                            </button>
                        }
                    </details>
                }
                <details class="scenario-model" open>
                    <summary>Custom model</summary>
                    <label class="upload-button">Upload new model <InputFile accept=".glb,.gltf" OnChange="SelectFile" /></label>
                    @if (File is not null) { <button type="button" class="scenario-button" @onclick="OpenUpload">Open @File.Name</button> }
                </details>
            </nav>
            @if (Error is not null && ModelUrl is null) { <p role="alert" class="scenario-error">@Error</p> }
        </aside>

        @if (ModelUrl is not null)
        {
            <div class="app-stage">
                <div class="app-viewer">
                    @if (Error is not null)
                    {
                        <div class="app-overlay app-overlay--error" role="alert"><p>⚠️ @Error</p></div>
                    }
                    <WarningViewer @ref="Viewer" ModelUrl="@ModelUrl" Defects="Defects" PartsVisibility="PartsVisibility"
                                   SelectionOptions="SelectionOptions" Locale="Locale"
                                   DefectsChanged="OnDefectsChanged" ModelLoaded="OnModelLoaded"
                                   SnapshotReport="OnSnapshotReport" ModelLoadError="OnModelLoadError" />
                </div>

                <aside id="details-panel" class="app-sidebar @(PanelOpen ? null : "app-sidebar--collapsed")" aria-label="@PanelTitle">
                    <div class="sidebar-header">
                        <h2 class="sidebar-title">
                            @PanelTitle
                            <span class="sidebar-count" aria-label="@Defects.Count defects">@Defects.Count</span>
                        </h2>
                        <button class="panel-collapse-btn" type="button" aria-controls="details-panel"
                                aria-expanded="@(PanelOpen ? "true" : "false")"
                                aria-label="@((PanelOpen ? "Collapse " : "Expand ") + PanelTitle.ToLowerInvariant() + " panel")"
                                @onclick="() => PanelOpen = !PanelOpen"><span class="chev" aria-hidden="true">›</span></button>
                    </div>

                    @if (PanelOpen && Page == "viewer")
                    {
                        <div class="sidebar-body">
                            <section class="sidebar-section">
                                <h3 class="sidebar-title">Parts Visibility</h3>
                                @if (Parts.Count == 0) { <p class="sidebar-empty">Loading parts…</p> }
                                <ul class="part-list">
                                    @foreach (var part in Parts)
                                    {
                                        <li class="part-item">
                                            <label class="part-label">
                                                <input type="checkbox" checked="@Visible(part.Name)" @onchange="e => TogglePart(part.Name, (bool)e.Value!)" />
                                                <span class="@(Visible(part.Name) ? null : "part-label--hidden")">@part.Name</span>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            </section>

                            <section class="sidebar-section">
                                <h3 class="sidebar-title">Defects (@Defects.Count)</h3>
                                @if (Defects.Count == 0)
                                {
                                    <p class="sidebar-empty">Tap or click on the model to add defects.</p>
                                }
                                <ul class="defect-list">
                                    @foreach (var defect in Defects)
                                    {
                                        var label = defect.Metadata?.GetValueOrDefault("optionLabel")?.ToString() ?? defect.Label;
                                        <li class="defect-item">
                                            <span class="defect-severity defect-severity--@(defect.Severity ?? "error")"></span>
                                            <span class="defect-label">@label</span>
                                            <span class="defect-part">@defect.MeshName</span>
                                            <button class="defect-remove" type="button" title="Remove" aria-label="Remove @(label ?? "defect")"
                                                    @onclick="() => RemoveDefect(defect.Id)">✕</button>
                                        </li>
                                    }
                                </ul>
                            </section>

                            <section class="sidebar-section">
                                <h3 class="sidebar-title">
                                    <button class="sidebar-toggle" type="button" aria-expanded="@(ShowReports ? "true" : "false")"
                                            @onclick="() => ShowReports = !ShowReports">
                                        Snapshots (@Reports.Count) @(ShowReports ? "▾" : "▸")
                                    </button>
                                </h3>
                                @if (ShowReports)
                                {
                                    @if (Reports.Count == 0) { <p class="sidebar-empty">Add a defect to generate the first snapshot report.</p> }
                                    @foreach (var report in Reports)
                                    {
                                        <div class="report-card">
                                            <div class="report-images">
                                                @foreach (var image in report.Images)
                                                {
                                                    <figure class="report-figure">
                                                        <img class="report-thumb" src="@image.DataUri" alt="@image.View view" />
                                                        <figcaption>@image.View</figcaption>
                                                    </figure>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </section>
                        </div>
                    }
                    else if (PanelOpen)
                    {
                        <div class="sidebar-body">
                            <section class="analytics-summary">
                                <span>Total warnings</span>
                                <strong>@Defects.Count</strong>
                                <small>@ComponentStats.Count affected components</small>
                            </section>
                            <section class="sidebar-section">
                                <h3 class="sidebar-title">Warnings by type</h3>
                                @if (TypeStats.Count == 0) { <p class="sidebar-empty">No warnings recorded.</p> }
                                @foreach (var item in TypeStats)
                                {
                                    <div class="stat-row">
                                        <div><span>@item.Label</span><strong>@item.Count</strong></div>
                                        <div class="stat-track"><span style="width:@((item.Count / (double)MaxCount(TypeStats) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                    </div>
                                }
                            </section>
                            <section class="sidebar-section">
                                <h3 class="sidebar-title">Surface heat map</h3>
                                <div class="heat-legend"><span>Low</span><i></i><span>High</span></div>
                                @foreach (var item in ComponentStats)
                                {
                                    <div class="heat-row"><span>@item.Label</span><strong>@item.Count</strong></div>
                                }
                            </section>
                        </div>
                    }
                </aside>
            </div>
        }
        else
        {
            <main class="demo-setup">
                <h2>Inspection workspace</h2>
                <p>Select a preset scenario from the menu or upload a GLB model.</p>
                <button class="toolbar-btn toolbar-btn--accent mobile-only" type="button" @onclick="() => ScenarioMenuOpen = true">Browse scenarios</button>
            </main>
        }
    </div>
</div>

@code {
    private string? ModelUrl;
    private string Model = "";
    private string ActiveLabel = "Demo";
    private string Page = "viewer";
    private int PendingWarningCount;
    private string? ActiveModelId;
    private bool RetryingModelFallback;
    private string? Error;
    private IBrowserFile? File;
    private IJSObjectReference? DemoModule;
    private readonly string[] CameraViews = ["Front", "Back", "Left", "Right", "Top", "Bottom"];
    private readonly ViewerLocale Locale = new() { ModalTitle = "Select defect", ModalPartLabel = "Part:", ModalCancel = "Cancel" };
    private readonly List<SelectionOption> SelectionOptions =
    [
        new() { Id = "scratch", Label = "Scratch", Severity = "warning" },
        new() { Id = "dent", Label = "Dent", Severity = "error" },
        new() { Id = "rust", Label = "Rust", Severity = "error" },
        new() { Id = "crack", Label = "Crack", Severity = "error" },
        new() { Id = "misalignment", Label = "Misalignment", Severity = "info" },
    ];
    private readonly List<WarningDefect> Defects = new();
    private List<ModelPartVisibility> PartsVisibility = new();
    private List<ViewerPart> Parts = new();
    private List<SnapshotReport> Reports = new();
    private WarningViewer? Viewer;
    private bool PanelOpen = true;
    private bool ShowReports;
    private bool ScenarioMenuOpen = true;
    private string PanelTitle => Page == "analytics" ? "Analytics" : "Details";

    // On phones the menu is a drawer and the panel a bottom sheet: start with the panel collapsed.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        DemoModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");
        if (await DemoModule.InvokeAsync<bool>("isCompact"))
        {
            PanelOpen = false;
            StateHasChanged();
        }
    }

    private async Task PickScenario(ModelAsset asset, ModelScenario scenario)
    {
        await StartDemo(asset, scenario);
        await CloseMenuOnCompactAsync();
    }

    private async Task OpenUpload()
    {
        await StartUploadedDemo();
        await CloseMenuOnCompactAsync();
    }

    private async Task CloseMenuOnCompactAsync()
    {
        DemoModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");
        if (await DemoModule.InvokeAsync<bool>("isCompact")) ScenarioMenuOpen = false;
    }
    private List<ModelAsset> Models = [];
    private List<Statistic> TypeStats => AggregateDefects(true);
    private List<Statistic> ComponentStats => AggregateDefects(false).OrderByDescending(item => item.Count).ToList();

    private void SelectFile(InputFileChangeEventArgs args) => File = args.File;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Models = await Http.GetFromJsonAsync<List<ModelAsset>>("assets/models.json")
                ?? throw new InvalidOperationException("The model library is empty.");
            Model = Models.FirstOrDefault()?.Id ?? "";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            Error = $"Could not load models: {ex.Message}";
        }
    }

    private async Task StartDemo(ModelAsset asset, ModelScenario demoScenario)
    {
        Error = null;
        try
        {
            var initial = new List<WarningDefect>();
            if (demoScenario.Id == "preset")
            {
                var scenarios = await Http.GetFromJsonAsync<Dictionary<string, List<WarningDefect>>>("assets/scenarios.json");
                if (scenarios is not null && scenarios.TryGetValue(asset.Id, out var preset)) initial = preset;
            }
            PendingWarningCount = initial.Count == 0 ? (demoScenario.WarningCount ?? 0) : 0;
            var nextUrl = BuildModelUrl(asset.Id, useAssetsPrefix: true);
            var reuseEngine = nextUrl == ModelUrl;
            Reports.Clear();
            Defects.Clear();
            Defects.AddRange(initial);
            if (reuseEngine && Viewer is not null)
            {
                await Viewer.SetDefectsAsync(initial);
                if (PendingWarningCount > 0)
                {
                    await Viewer.AddDistributedWarningsAsync(PendingWarningCount);
                    PendingWarningCount = 0;
                }
            }
            if (!reuseEngine)
            {
                Parts.Clear();
                PartsVisibility.Clear();
            }
            Model = asset.Id;
            ActiveModelId = asset.Id;
            RetryingModelFallback = false;
            Page = "viewer";
            ActiveLabel = $"{asset.Label} — {demoScenario.Label}";
            ModelUrl = nextUrl;
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or InvalidOperationException or JSException or System.Text.Json.JsonException)
        {
            Error = ex.Message;
        }
    }

    private async Task StartUploadedDemo()
    {
        if (File is null) { Error = "Choose a GLB file first."; return; }
        await using var stream = File.OpenReadStream(100 * 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        DemoModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./demo.js");
        PendingWarningCount = 0;
        ActiveModelId = null;
        RetryingModelFallback = false;
        Defects.Clear();
        Parts.Clear();
        PartsVisibility.Clear();
        Reports.Clear();
        Page = "viewer";
        ActiveLabel = $"{File.Name} — Uploaded model";
        ModelUrl = await DemoModule.InvokeAsync<string>("createModelUrl", buffer.ToArray());
    }

    private async Task ChangeDemo()
    {
        var oldUrl = ModelUrl;
        ModelUrl = null;
        ActiveModelId = null;
        RetryingModelFallback = false;
        Error = null;
        Page = "viewer";
        if (oldUrl?.StartsWith("blob:", StringComparison.Ordinal) == true && DemoModule is not null)
            await DemoModule.InvokeVoidAsync("revokeModelUrl", oldUrl);
    }

    public async ValueTask DisposeAsync()
    {
        await ChangeDemo();
        if (DemoModule is not null) await DemoModule.DisposeAsync();
    }

    private Task OnDefectsChanged(List<WarningDefect> defects) { Defects.Clear(); Defects.AddRange(defects); return Task.CompletedTask; }
    private async Task OnModelLoaded(List<ViewerPart> parts)
    {
        Parts = parts;
        PartsVisibility = parts.Select(part => new ModelPartVisibility { MeshName = part.Name, Visible = true }).ToList();
        if (PendingWarningCount > 0 && Viewer is not null)
        {
            await Viewer.AddDistributedWarningsAsync(PendingWarningCount);
            PendingWarningCount = 0;
        }
    }
    private Task OnSnapshotReport(SnapshotReport report) { Reports.Clear(); Reports.Add(report); return Task.CompletedTask; }
    private Task OnModelLoadError(string error)
    {
        if (ActiveModelId is not null && !RetryingModelFallback && ModelUrl == BuildModelUrl(ActiveModelId, useAssetsPrefix: true))
        {
            RetryingModelFallback = true;
            Error = null;
            ModelUrl = BuildModelUrl(ActiveModelId, useAssetsPrefix: false);
            return Task.CompletedTask;
        }
        Error = $"Failed to load model: {error}";
        return Task.CompletedTask;
    }
    private bool Visible(string name) => PartsVisibility.FirstOrDefault(part => part.MeshName == name)?.Visible ?? true;
    private void TogglePart(string name, bool visible) { var part = PartsVisibility.FirstOrDefault(part => part.MeshName == name); if (part is not null) part.Visible = visible; }
    private async Task SetCameraView(string direction) { if (Viewer is not null) await Viewer.SetCameraViewAsync(direction); }
    private async Task ZoomToFit() { if (Viewer is not null) await Viewer.ZoomToFitAsync(); }
    private async Task Undo() { if (Viewer is not null) await Viewer.UndoAsync(); }
    private async Task Redo() { if (Viewer is not null) await Viewer.RedoAsync(); }
    private async Task ClearAll() { if (Viewer is not null) await Viewer.ClearAllDefectsAsync(); }
    private void RemoveDefect(string id) { Defects.RemoveAll(defect => defect.Id == id); }
    private async Task SetPage(string page)
    {
        Page = page;
        if (Viewer is not null) await Viewer.SetHeatMapAsync(page == "analytics");
    }
    private static int MaxCount(List<Statistic> items) => Math.Max(1, items.Select(item => item.Count).DefaultIfEmpty().Max());
    private static string BuildModelUrl(string modelId, bool useAssetsPrefix)
    {
        var prefix = useAssetsPrefix ? "assets/models" : "models";
        return $"{prefix}/{modelId}.glb";
    }
    private List<Statistic> AggregateDefects(bool byType)
    {
        return Defects.GroupBy(defect => byType
                ? defect.Metadata?.GetValueOrDefault("optionLabel")?.ToString() ?? defect.Label ?? "Unclassified"
                : defect.MeshName ?? "Unassigned")
            .Select(group => new Statistic(group.Key, group.Count()))
            .ToList();
    }

    private sealed record ModelScenario(string Id, string Label, string? Badge, int? WarningCount);
    private sealed record ModelAsset(string Id, string Label, bool HasPreset, List<ModelScenario>? Scenarios);
    private sealed record Statistic(string Label, int Count);
}
