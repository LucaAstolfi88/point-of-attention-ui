{
  "name": "@point-of-attention-ui/react",
  "version": "1.0.0",
  "description": "React wrapper for the Point of Attention 3D defect viewer",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@point-of-attention-ui/core": "1.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "keywords": ["react", "3d-viewer", "defect-marking", "point-of-attention"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucaAstolfi88/point-of-attention-ui.git",
    "directory": "packages/react"
  }
}
