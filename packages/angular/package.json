{
  "name": "@point-of-attention-ui/angular",
  "version": "1.0.0",
  "description": "Angular wrapper for the PointOfAttention 3D point-of-attention viewer (standalone, no ABP)",
  "module": "./dist/fesm2022/point-of-attention-ui-angular.mjs",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/point-of-attention-ui-angular.mjs"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json"
  },
  "peerDependencies": {
    "@angular/common": ">=17",
    "@angular/core": ">=17"
  },
  "dependencies": {
    "@point-of-attention-ui/core": "1.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/core": "~17.1.0",
    "@angular/common": "~17.1.0",
    "@angular/compiler": "~17.1.0",
    "@angular/compiler-cli": "~17.1.0",
    "ng-packagr": "~17.1.0",
    "typescript": "~5.3.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "angular",
    "threejs",
    "3d-viewer",
    "defect-marking",
    "point-of-attention",
    "visual-inspection"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Luca Astolfi",
  "homepage": "https://github.com/LucaAstolfi88/point-of-attention-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucaAstolfi88/point-of-attention-ui.git",
    "directory": "packages/angular"
  }
}
